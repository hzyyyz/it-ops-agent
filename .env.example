# LLM 配置
# 密钥由 model/factory.py 按 OPENAI_BASE_URL 自动选择：
#   指向 deepseek 端点 -> 用 DEEPSEEK_API_KEY；指向 OpenAI -> 用 OPENAI_API_KEY。
# 只需填当前端点对应的那一个；也可以都不填，改在 config/rag.yml 里写 openai_api_key。
CHAT_MODEL_NAME=deepseek-v4-flash
OPENAI_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# Embedding 模型（HuggingFace 本地加载）
EMBEDDING_MODEL_NAME=BAAI/bge-small-zh-v1.5
RAG_RETRIEVAL_MODE=advanced
RAG_RERANKER_MODEL=BAAI/bge-reranker-base
# Docker 离线加载模型时，改成宿主机已有的 HuggingFace 缓存目录。
# HF_CACHE_HOST_PATH=C:/Users/your-name/.cache/huggingface

# 可观测性：JSONL 事件文件。Docker 中默认写入已挂载的 /app/logs。
AGENT_TRACE_FILE=logs/traces.jsonl

# 本地管理员口令，至少 32 个随机字符；同时供 API 和 Streamlit 使用。
AGENT_ADMIN_TOKEN=replace-with-at-least-32-random-characters

# Streamlit 访问 FastAPI 的地址（Docker Compose 内使用 http://api:8000）
AGENT_API_URL=http://127.0.0.1:8000

# 独立监控 MCP 服务（本地运行 python -m mcp_tools.server）
MCP_SERVER_URL=http://127.0.0.1:8001/mcp

# 本地 MySQL 会话存储（请先创建专用空数据库）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=it_ops_agent
MYSQL_USER=it_ops_agent
MYSQL_PASSWORD=replace-with-your-database-password

# 可选：最近 100 条会话上下文缓存。未设置时直接从 MySQL 读取。
# 本地 Redis 服务示例：redis://127.0.0.1:6379/0
# REDIS_URL=redis://127.0.0.1:6379/0

# 仅 Docker Compose 初始化新 MySQL 容器时使用
MYSQL_ROOT_PASSWORD=replace-with-a-separate-root-password
